# FastAPI runtime configuration.
# Mirrors backend-rust/.env so this service can run against the same database.
HOST=127.0.0.1
PORT=8080

# MySQL 8 is the runtime database. The database is created when missing.
# PyMySQL driver prefix is required by SQLAlchemy.
DATABASE_URL=mysql+pymysql://root:root123@127.0.0.1:3306/education
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10

CORS_ALLOW_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

STORAGE_DIR=data/uploads

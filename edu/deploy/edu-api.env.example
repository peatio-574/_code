# FastAPI 后端生产配置（部署到 /srv/edu-api/app/.env）
# 数据库复用服务器现有 education_rust；账号为应用账号（非 root），密码含特殊字符需 URL 编码。
HOST=127.0.0.1
PORT=18081

DATABASE_URL=mysql+pymysql://<db_user>:<url_encoded_password>@127.0.0.1:3306/education_rust
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10

CORS_ALLOW_ORIGINS=http://118.24.15.163,http://pinslive.com
COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# 复用旧 Rust 后端的上传目录（视频/封面/头像）
STORAGE_DIR=/srv/education/shared/data/uploads

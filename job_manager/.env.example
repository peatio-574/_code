# 复制为 .env 使用（deploy.sh 会按需自动生成；请勿把 .env 提交到版本库）
# 未设置的项会回退到 app/config.py 中的默认值。

# ---------- 安全 ----------
SECRET_KEY=请改为一段随机长字符串

# ---------- 数据库 ----------
# 统一由 DB_* 组成（app/config.py 与 init_db.py 共享同一来源，密码只写一份）
# 密码含特殊字符（@ & / : 等）无需编码，这里存原文即可。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=job_CAIQABiAB
DB_PASSWORD=你的数据库密码
DB_NAME=job
# 也可直接用完整连接串覆盖（优先级更高）：
# DATABASE_URL=mysql+pymysql://用户名:URL编码后的密码@127.0.0.1:3306/job?charset=utf8mb4

# ---------- AI 简历识别（OpenAI 兼容协议） ----------
# 配置了 AI_API_KEY 才调用外部大模型；否则回退本地启发式分析。
AI_API_KEY=sk-你的DeepSeekKey
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash-vision-exp
